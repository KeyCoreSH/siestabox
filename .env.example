# Copie para .env e ajuste antes de subir em produção.
POSTGRES_DB=siestabox_db
POSTGRES_USER=keycore_admin
POSTGRES_PASSWORD=troque-esta-senha

# Portas publicadas no host
API_HOST_PORT=8080
WEB_HOST_PORT=8131
MQTT_HOST_PORT=1883

# Prefixo dos tópicos MQTT
MQTT_PREFIX=siestabox

# Simulador de firmware (perfil `sim`)
TELEMETRY_INTERVAL_S=10
DOOR_FLAP=1

# URL pública da API, embutida no frontend em tempo de build
# (deixe vazio para o frontend usar a própria origem + proxy /api e /ws)
SIESTA_API_BASE=

LOG_LEVEL=info
